{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "autoDocstring.docstringFormat": "sphinx",
  "cSpell.ignorePaths": [
    "**test**"
  ],
  "mypy-type-checker.ignorePatterns": [
    "**/site-packages/**/*.py",
    ".vscode/*.py",
    ".venv",
    "submodules"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.venv": true,
    "**/submodules": true
  },
  "markdownlint.config": {
    "no-inline-html": {
      "allowed_elements": ["p","h1","strong","a","br"]
    },
    "blanks-around-headings": {
      "lines_above": 0
    },
    "no-multiple-blanks": {
      "maximum": 2
    },
    "first-line-heading": false,
    "first-line-h1": false,
    "link-image-reference-definitions": {
      "ignored_definitions": [ "repo", "//" ]
    }
  },
  "isort.args": [
    "--profile",
    "black"
  ],
  "languageToolLinter.languageTool.ignoredWordsInWorkspace": [
    " macport",
    "codium",
    "cpython",
    "docstring",
    "docstrings",
    "isort",
    "macos-latest",
    "mypy",
    "redistributables",
    "rest",
    "rimsort",
    "shfmt",
    "steamfiles",
    "steamworks",
    "steamworks-sdk",
    "steamworkspy",
    "todds",
    "virtualenv"
  ],
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestArgs": [
    "."
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "search.maxResults": 100000,
  "yaml.schemas": {
    "https://json.schemastore.org/github-issue-config.json": "file:///c%3A/Code%20Repos/RimSort/.github/ISSUE_TEMPLATE/config.yml"
  }
}